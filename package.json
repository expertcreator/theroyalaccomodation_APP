{
  "name": "TheRoyalAccommodation",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "clean": "cd android && ./gradlew clean",
    "connect": "adb reverse tcp:8081 tcp:8081",
    "android-build": "cd android && ./gradlew clean && ./gradlew assembleRelease && cd ..",
    "build-android-bundle": "cd android && ./gradlew clean && cd .. && npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle android/app/src/main/res",
    "android-app-bundle": "cd android && ./gradlew clean && cd .. && npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle android/app/src/main/res && cd android && ./gradlew bundleRelease && cd ..",
    "connect-run": "adb reverse tcp:8081 tcp:8081 && npx react-native run-android",
    "connect-fast-run": "adb reverse tcp:8081 tcp:8081 && yarn react-native run-android --active-arch-only",
    "info": "npx react-native info",
    "start-logs": "npx @react-native-community/cli start --client-logs",
    "fast-run": "yarn react-native run-android --active-arch-only",
    "structure": "tree -I 'node_modules|android|ios|.git|vendor' -L 50 > structure.txt",
    "postinstall": "patch-package",
    "make-patch": "npx patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-vector-icons/feather": "^13.1.4",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/drawer": "^7.14.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@sominaththore/react-native-custom-status-bar": "^1.1.0",
    "@stripe/stripe-react-native": "^0.77.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-keyboard-controller": "^1.22.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.28.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-toast-notifications": "^3.4.0",
    "react-native-worklets": "^0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
